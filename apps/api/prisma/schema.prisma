  evolutionApiKey        String?
  evolutionWebhookUrl    String?
  evolutionWebhookSecret String?
  metaWebhookVerifyToken String?
  googleClientId         String?
  googleClientSecret     String?
  googleRedirectUri      String?
  googleAuthRedirectUri  String?
  webUrl                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configuração dinâmica de provedores de IA (substitui as keys do .env).
// A API key é cifrada com AES-256-GCM (lib/crypto.ts) — nunca em texto puro.
model AiProviderConfig {
  provider         String    @id // gemini | openrouter | anthropic | openai
  enabled          Boolean   @default(false)
  apiKeyCiphertext Bytes?
  apiKeyIv         Bytes?
  apiKeyAuthTag    Bytes?
  extra            Json? // { siteUrl, baseUrl, ... } específico do provider
  models           AiModel[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Modelos cadastrados pelo usuário sob um provedor (ex: vários modelos do OpenRouter).
// O sistema (agentes, sugestões) escolhe entre estes modelos.
model AiModel {
  id          String   @id @default(cuid())
  provider    String // FK lógica p/ AiProviderConfig.provider
  modelId     String // slug enviado à API (ex: "openai/gpt-4o-mini")
  label       String // nome amigável exibido na UI
  description String?  @db.Text // particularidades / notas do modelo
  temperature Float? // temperatura padrão sugerida
  maxTokens   Int? // limite de tokens padrão
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false) // modelo padrão do sistema (sugestões, fallback)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  config AiProviderConfig @relation(fields: [provider], references: [provider], onDelete: Cascade)

  @@unique([provider, modelId])
  @@index([provider])
}

// ─── Enums ───────────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  MEMBER
}

enum PhoneType {
  PN // Phone Number — telefone real, contactável
  LID // Linked ID — identificador opaco do WhatsApp (privacidade)
  UNKNOWN // ainda não classificado
}

enum ChannelType {
  WHATSAPP
  GMAIL
  IMAP_SMTP
  INTERNAL // chat interno entre usuários do workspace (1:1 e grupos)
  META_WHATSAPP
  META_INSTAGRAM
  META_MESSENGER
}

enum ConversationType {
  EXTERNAL // conversa via canal externo (WhatsApp, e-mail) — comportamento legado
  DIRECT // chat interno 1:1 entre 2 usuários
  GROUP // chat interno em grupo (3+ usuários)
}

enum ChatRole {
  OWNER
  MEMBER
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum EvolutionServerStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CreatedBy {
  USER
  AI
}

enum ConversationStatus {
  OPEN // em atendimento
  WAITING // aguardando resposta do cliente
  RESOLVED // finalizada
}

// ─── Quick Replies ────────────────────────────────────────────────────────────
model QuickReply {
  id          String   @id @default(cuid())
  workspaceId String
  shortcut    String // atalho digitado após /
  title       String?
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, shortcut])
  @@index([workspaceId])
}

enum ConvSource {
  LIVE // criada por mensagem real-time (Evolution socket)
  IMPORTED // veio do sync de histórico — nasce RESOLVED
}

// ─── Teams (Setores de Atendimento) ──────────────────────────────────────────
// Setores como Suporte, Vendas, Financeiro. Cada conversa pode pertencer a um team
// (Conversation.teamId), e a distribuição entre os membros do team segue seu próprio
// distributionMode (sobrepõe canal/workspace).
model Team {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  slug        String // identificador estável (usado em flows e logs)
  color       String  @default("#6366f1")
  icon        String? // nome de ícone lucide (ex: "headphones", "shopping-cart")
  description String? @db.Text

  // Regras de distribuição internas do team.
  // 'all' = todos os membros ativos veem na fila
  // 'fixed' = sempre vai pro defaultAssigneeId
  // 'round_robin' = distribui em cursor sequencial
  // 'load_balanced' = membro com menos conversas OPEN ganha
  distributionMode  String  @default("all")
  defaultAssigneeId String? // usado por 'fixed' — FK lógica
  roundRobinUserIds Json? // string[] explícito (se null em RR, usa membros ativos)
  rrCursor          Int     @default(0)

  // SLA e horário (opcionais)
  businessHours       Json? // { mon: [{ start: "08:00", end: "18:00" }], ... }
  slaFirstResponseMin Int? // minutos pra primeira resposta
  slaResolutionMin    Int? // minutos pra resolução
  overflowTeamId      String? // se ninguém disponível dentro do horário/capacity, transborda

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workspace     Workspace              @relation(fields: [workspaceId], references: [id])
  members       TeamMembership[]
  conversations Conversation[]
  overflowTeam  Team?                  @relation("TeamOverflow", fields: [overflowTeamId], references: [id])
  overflowOf    Team[]                 @relation("TeamOverflow")
  channels      Channel[]              @relation("ChannelDefaultTeam")
  transfersFrom ConversationTransfer[] @relation("TransferFromTeam")
  transfersTo   ConversationTransfer[] @relation("TransferToTeam")
  routingRules  RoutingRule[]          @relation("RuleAssignTeam")
  boardShares   BoardTeamShare[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, isActive])
}

model TeamMembership {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(AGENT)
  // Pausar agente no team sem remover (ex: férias). Inativos não recebem RR/LB.
  isActive Boolean  @default(true)
  // Limite máximo de conversas OPEN simultâneas (usado por load_balanced).
  // null = sem limite.
  capacity Int?
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId, isActive])
}

enum TeamRole {
  LEADER
  AGENT
}

// ─── Histórico estruturado de transferências ─────────────────────────────────
// Substitui Conversation.releasedFrom (Json) com tabela auditável. Cada transferência
// (user→user, user→team, team→team, system→team, release pra fila) gera 1 linha.
model ConversationTransfer {
  id             String @id @default(cuid())
  workspaceId    String
  conversationId String

  fromUserId String?
  fromTeamId String?
  toUserId   String?
  toTeamId   String?

  // SYSTEM = roteamento automático (regra, flow, novo ticket)
  // MANUAL = ação humana via UI
  // RELEASE = devolução à fila (também grava aqui pra ter timeline única)
  // TAKEOVER = admin assumiu de outro atendente
  kind   TransferKind @default(MANUAL)
  reason String?      @db.Text

  actorUserId String? // user que disparou (null = sistema)
  createdAt   DateTime @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUser     User?        @relation("TransferFromUser", fields: [fromUserId], references: [id])
  toUser       User?        @relation("TransferToUser", fields: [toUserId], references: [id])
  fromTeam     Team?        @relation("TransferFromTeam", fields: [fromTeamId], references: [id])
  toTeam       Team?        @relation("TransferToTeam", fields: [toTeamId], references: [id])
  actor        User?        @relation("TransferActor", fields: [actorUserId], references: [id])

  @@index([workspaceId, conversationId, createdAt])
  @@index([workspaceId, toTeamId, createdAt])
}

enum TransferKind {
  SYSTEM
  MANUAL
  RELEASE
  TAKEOVER
}

// ─── Routing Rules (Regras dinâmicas de roteamento) ──────────────────────────
// Avaliadas em ordem de prioridade ANTES dos fallbacks (canal/workspace).
// Permite "se contato tem tag VIP → atribui a João", "se canal=Vendas-WA → vai pra team Vendas",
// "se palavra-chave 'orçamento' → start flow Vendas".
model RoutingRule {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?
  // Filtros que devem TODOS bater (AND). null = sem filtro nesse eixo.
  // { channelIds?: string[], channelTypes?: string[], companyIds?: string[],
  //   contactTagsAny?: string[], keywordsAny?: string[], businessHours?: bool,
  //   isGroup?: bool }
  matcher     Json
  // Ação a executar quando bater.
  // { type: 'assign_team'|'assign_user'|'start_flow'|'add_tag',
  //   teamId?: string, userId?: string, flowId?: string, tags?: string[] }
  action      Json
  priority    Int     @default(100)
  isActive    Boolean @default(true)
  // Limita avaliação aos triggers selecionados.
  // Default: ['new_conversation']
  triggers    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  // FK opcional pra facilitar joins quando action.type='assign_team'
  assignTeam   Team?     @relation("RuleAssignTeam", fields: [assignTeamId], references: [id])
  assignTeamId String?

  @@index([workspaceId, isActive, priority])
  @@index([assignTeamId])
}

// ─── Flows (Jornadas de Atendimento) ─────────────────────────────────────────
// Grafo de nós executado pelo flowExecutor.worker.ts. Cada nó muta o contexto
// e/ou tem side effects (enviar mensagem, atribuir time, etc).
//
// Trigger:
//   { type: 'new_conversation' | 'message_received' | 'manual',
//     filters?: { channelIds?: string[], channelTypes?: string[],
//                 keywordsAny?: string[], companyIds?: string[] } }
//
// Graph:
//   { nodes: [{ id, type, position: {x,y}, data: {...} }],
//     edges: [{ id, source, sourceHandle?, target }] }
//
// Tipos de nó (extensível em nodes/registry.ts):
//   - start          (entry point — único e obrigatório)
//   - message        (envia texto/mídia)
//   - menu           (envia opções e aguarda resposta — pausa em WAITING_INPUT)
//   - condition      (branch por expressão sobre context/contact/conv)
//   - assign_team    (move conv pra fila do team)
//   - assign_user    (atribui direto a um user)
//   - start_bot      (invoca um Agent)
//   - wait_for_human (sai do flow e fica em fila — pode reativar)
//   - tag            (adiciona tags à conv ou contato)
//   - end
model Flow {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?  @db.Text
  trigger     Json
  graph       Json
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  priority    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id])
  executions FlowExecution[]
  channels   Channel[]       @relation("ChannelDefaultFlow")

  @@index([workspaceId, isActive, priority])
}

model FlowExecution {
  id             String    @id @default(cuid())
  workspaceId    String
  flowId         String
  conversationId String
  currentNodeId  String?
  // RUNNING | WAITING_INPUT | COMPLETED | FAILED | CANCELLED
  status         String    @default("RUNNING")
  // Variáveis acumuladas { lastMenuChoice, contactTags, custom: {...} }
  context        Json
  // Histórico de nós visitados pra debug/auditoria.
  trace          Json?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  flow         Flow         @relation(fields: [flowId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([workspaceId, status])
}

// ─── Central de Comunicação ──────────────────────────────────────────────────
// Camada única de envios (WhatsApp/Email hoje, outros canais no futuro). Nenhum
// módulo fala direto com Evolution/SMTP — todos passam por communication.service.

enum CommChannel {
  WHATSAPP
  EMAIL
}

enum CommStatus {
  PENDING // pronta pra enviar imediatamente
  SCHEDULED // aguardando horário agendado
  PROCESSING // worker pegou o job
  SENT // entregue ao provedor
  FAILED // esgotou tentativas
  CANCELED // cancelada manualmente
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELED
}

// Campanha de envio em massa. Materializa N CommMessage no disparo.
model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  description String?        @db.Text
  channelType CommChannel
  channelId   String? // Channel específico; null = auto (1º conectado do tipo)
  subject     String? // usado em e-mail
  body        String         @db.Text
  status      CampaignStatus @default(DRAFT)
  listId      String? // BroadcastList alvo
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdBy   String? // User.id
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  list        BroadcastList?   @relation(fields: [listId], references: [id])
  messages    CommMessage[]
  attachments CommAttachment[]

  @@index([workspaceId, status])
  @@index([listId])
}

// Lista de transmissão reutilizável (só Contatos cadastrados).
model BroadcastList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id])
  members   BroadcastListMember[]
  campaigns Campaign[]

  @@index([workspaceId])
}

model BroadcastListMember {
  id        String   @id @default(cuid())
  listId    String
  contactId String
  createdAt DateTime @default(now())

  list    BroadcastList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([contactId])
}

// Item da fila / log de uma mensagem individual.
model CommMessage {
  id          String      @id @default(cuid())
  workspaceId String
  campaignId  String? // null = envio avulso (API/módulo interno)
  contactId   String? // null = destinatário avulso (string crua via API)
  channelType CommChannel
  channelId   String? // Channel resolvido; null = auto no dispatch
  to          String // destinatário (telefone/email)
  subject     String?
  body        String      @db.Text
  status      CommStatus  @default(PENDING)
  priority    Int         @default(0) // maior = mais prioritário
  scheduledAt DateTime?
  sentAt      DateTime?
  attempts    Int         @default(0)
  lastError   String?     @db.Text
  externalId  String? // id da mensagem no provedor (Evolution/Meta/SMTP)
  source      String      @default("api") // campaign | api | billing | crm | ...
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  campaign    Campaign?        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact?         @relation(fields: [contactId], references: [id])
  attachments CommAttachment[]
  logs        CommMessageLog[]

  @@index([workspaceId, status])
  @@index([campaignId])
  @@index([scheduledAt])
}

// Anexo já normalizado e gravado no storage (nunca Base64 cru no worker).
model CommAttachment {
  id            String   @id @default(cuid())
  workspaceId   String
  campaignId    String?
  commMessageId String?
  filename      String
  mimeType      String
  sizeBytes     Int
  storageKey    String // caminho relativo a STORAGE_PATH
  createdAt     DateTime @default(now())

  workspace  Workspace    @relation(fields: [workspaceId], references: [id])
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  commMessage CommMessage? @relation(fields: [commMessageId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([commMessageId])
}

// Histórico/auditoria de cada envio.
model CommMessageLog {
  id            String   @id @default(cuid())
  commMessageId String
  // RECEIVED | CREATED | PROCESSING | PROVIDER_OK | PROVIDER_ERROR | RETRY | CANCELED
  type          String
  detail        Json?
  createdAt     DateTime @default(now())

  commMessage CommMessage @relation(fields: [commMessageId], references: [id], onDelete: Cascade)

  @@index([commMessageId])
}

// API key para integração externa com a Central de Comunicação.
model CommApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String // primeiros 8 chars (visível na listagem)
  keyHash     String // hash SHA-256 do segredo completo
  scopes      Json // ex: ["messages.send"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdBy   String? // User.id
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([prefix])
  @@index([workspaceId])
}
