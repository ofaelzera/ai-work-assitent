  workspaceId String
  userId      String
  provider    String   @default("google")
  email       String? // email da conta Google
  tokens      Json // cifrado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  events    CalendarEvent[]

  @@unique([workspaceId, userId, provider])
}

model CalendarEvent {
  id                String   @id @default(cuid())
  workspaceId       String
  ownerId           String // user dono do evento (sempre obrigatório; eventos são por usuário)
  createdById       String? // quem criou (pode diferir do dono em agenda compartilhada)
  calendarAccountId String? // nullable: evento local (sem Google sync). Quando preenchido, está sincronizado.
  externalId        String? // nullable: ID no Google Calendar quando sincronizado
  title             String
  description       String?  @db.Text
  location          String?  @db.Text
  meetLink          String? // link de videoconferência (Google Meet, Teams, Zoom)
  attendees         Json? // [{ email, name, status }]
  allDay            Boolean  @default(false)
  status            String? // confirmed | tentative | cancelled
