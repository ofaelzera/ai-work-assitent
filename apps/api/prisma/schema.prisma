generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Workspace ────────────────────────────────────────────────────────────────
model Workspace {
  id        String   @id @default(cuid())
  name      String
  settings  Json? // { distributionMode, defaultAssigneeId, roundRobinUserIds, claimTimeoutMinutes }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  channels              Channel[]
  contacts              Contact[]
  conversations         Conversation[]
  messages              Message[]
  boards                Board[]
  cards                 Card[]
  tasks                 Task[]
  agents                Agent[]
  prompts               Prompt[]
  aiLogs                AIExecutionLog[]
  memoryChunks          MemoryChunk[]
  calendarAccounts      CalendarAccount[]
  calendarEvents        CalendarEvent[]
  vaultItems            VaultItem[]
  vaultFolders          VaultFolder[]
  attachments           Attachment[]
  storageFolders        StorageFolder[]
  eventLogs             EventLog[]
  companies             Company[]
  customRoles           CustomRole[]
  quickReplies          QuickReply[]
  teams                 Team[]
  routingRules          RoutingRule[]
  flows                 Flow[]
  flowExecutions        FlowExecution[]
  conversationTransfers ConversationTransfer[]
  userWorkingHours      UserWorkingHours[]
  scheduleBlocks        ScheduleBlock[]
  companyHours          CompanyHours[]
  holidays              Holiday[]
  campaigns             Campaign[]
  broadcastLists        BroadcastList[]
  commMessages          CommMessage[]
  commAttachments       CommAttachment[]
  commApiKeys           CommApiKey[]
}

// ─── Users ────────────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  workspaceId  String
  email        String    @unique
  googleId     String?   @unique
  passwordHash String?
  name         String
  role         Role      @default(MEMBER)
  customRoleId String?
  twoFactor    Boolean   @default(false)
  settings     Json? // { welcomeMessage?, closingMessage?, signature?, ... }
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace             Workspace                 @relation(fields: [workspaceId], references: [id])
  customRole            CustomRole?               @relation(fields: [customRoleId], references: [id])
  refreshTokens         RefreshToken[]
  vaultItems            VaultItem[]
  vaultFolders          VaultFolder[]
  assignedConversations Conversation[]            @relation("ConversationAssignee")
  assignedTasks         Task[]                    @relation("TaskAssignee")
  events                EventLog[]                @relation("EventActor")
  sentMessages          Message[]                 @relation("MessageUserSender")
  chatParticipations    ConversationParticipant[]
  messageReads          MessageRead[]
  conversationReads     ConversationRead[]
  createdCards          Card[]                    @relation("CardCreator")
  cardAssignments       CardAssignee[]
  teamMemberships       TeamMembership[]
  transfersFrom         ConversationTransfer[]    @relation("TransferFromUser")
  transfersTo           ConversationTransfer[]    @relation("TransferToUser")
  transfersBy           ConversationTransfer[]    @relation("TransferActor")

  @@index([workspaceId])
  @@index([customRoleId])
}

// Roles customizáveis por workspace (RBAC).
// `permissions` é um array de strings (ex: ["conversations.viewAll", "cards.delete"]).
// `isSystem=true` = role criado no seed; não pode ser deletado pela UI.
model CustomRole {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  permissions Json // string[] de permissions concedidas
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  users     User[]

  @@unique([workspaceId, name])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Evolution Servers ───────────────────────────────────────────────────────
model EvolutionServer {
  id              String                @id @default(cuid())
  name            String // "VPS Brasil", "VPS EUA"
  url             String // "https://evo.meusite.com"
  apiKey          String                @db.Text // criptografada (AES-256-GCM)
  status          EvolutionServerStatus @default(ACTIVE)
  maxInstances    Int                   @default(100)
  instanceCount   Int                   @default(0)
  priority        Int                   @default(0) // maior = preferido
  isHealthy       Boolean               @default(true)
  lastHealthCheck DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  channels Channel[]
}

// ─── Channels ────────────────────────────────────────────────────────────────
model Channel {
  id                String        @id @default(cuid())
  workspaceId       String
  evolutionServerId String? // null = fallback para env vars (retrocompatibilidade)
  type              ChannelType
  label             String
  status            ChannelStatus @default(DISCONNECTED)
  config            Json // segredos cifrados em repouso (AES-256-GCM)
  signature         String?       @db.Text // assinatura de email (HTML ou texto)
  settings          Json? // não-criptografado: { ignoreGroups, defaultAssigneeId, autoResolveOnRead, distributionMode, imapFolders, lastAssignedUserId }
  // Time padrão pra onde novas conversas vão quando nenhuma regra/empresa case.
  // Substitui (e é prioritário sobre) defaultAssigneeId do settings legado.
  defaultTeamId     String?
  // Flow disparado em novas conversas (null = sem flow automático). Sobrescrito por RoutingRule action=start_flow.
  defaultFlowId     String?
  lastSyncedAt      DateTime? // última sincronização bem-sucedida (usado pra delta sync)
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  evolutionServer EvolutionServer? @relation(fields: [evolutionServerId], references: [id])
  conversations   Conversation[]
  defaultTeam     Team?            @relation("ChannelDefaultTeam", fields: [defaultTeamId], references: [id])
  defaultFlow     Flow?            @relation("ChannelDefaultFlow", fields: [defaultFlowId], references: [id])

  @@index([workspaceId, type])
  @@index([evolutionServerId])
  @@index([defaultTeamId])
}

// ─── Contacts ────────────────────────────────────────────────────────────────
model Contact {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String?
  phone        String? // PN (Phone Number) — telefone real, ex: 5511999999999
  phoneType    PhoneType @default(PN) // PN = telefone real | LID = ID opaco WhatsApp
  lid          String? // Linked ID opaco do WhatsApp (quando phoneType=LID)
  email        String?
  metadata     Json?
  // Empresa "principal" denormalizada (só p/ exibição rápida e filtros legados).
  // FONTE DE VERDADE da associação N:N é ContactCompany — mantido em sincronia por
  // setContactCompanies()/linkContactCompany(). Não usar para regras de pertencimento.
  companyId    String?
  mergedIntoId String? // aponta para o contato primário ao mesclar

  // ── Cadastro estendido (RF01) ──────────────────────────────────────────────
  cpf       String? // só dígitos (11 chars); validado quando informado (RF06)
  birthDate DateTime? // data de nascimento (apenas data)
  verified  Boolean   @default(false) // RF02: sync=false, cadastro manual=true

  // Endereço estruturado (RF01)
  addrStreet     String? // logradouro
  addrNumber     String? // número
  addrComplement String? // complemento
  addrDistrict   String? // bairro
  addrCity       String? // cidade
  addrState      String? // estado (UF)
  addrZip        String? // CEP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id])
  company        Company?         @relation(fields: [companyId], references: [id]) // empresa principal denormalizada
  companies      ContactCompany[] // N:N (RF04) — fonte de verdade
  conversations  Conversation[]
  cards          Card[]
  cardLinks      CardContact[]
  sentMessages   Message[]        @relation("MessageSender")
  tasks          Task[]
  calendarEvents CalendarEvent[]
  broadcastListMemberships BroadcastListMember[]
  commMessages             CommMessage[]

  @@index([workspaceId, phone])
  @@index([workspaceId, lid])
  @@index([workspaceId, email])
  @@index([workspaceId, companyId])
  @@index([workspaceId, cpf])
}

// ─── Vínculo N:N Contato ↔ Empresa (RF04) ────────────────────────────────────
// Um contato pode pertencer a múltiplas empresas. `source` distingue vínculo
// criado manualmente (MANUAL) do derivado da sincronização de grupos (GROUP_SYNC).
model ContactCompany {
  contactId String
  companyId String
  source    String   @default("MANUAL") // MANUAL | GROUP_SYNC
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([contactId, companyId])
  @@index([companyId])
}

// ─── Companies ───────────────────────────────────────────────────────────────
model Company {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  color       String  @default("#6366f1")
  domain      String? // ex: empresa.com.br

  // Cadastro estendido
  logoUrl String? @db.LongText // data URL base64 — precisa de coluna grande
  cnpj    String?
  phone   String?
  email   String?
  website String?
  address String? @db.Text
  notes   String? @db.Text

  // Regras de distribuição de atendimentos.
  // Quando definidas, sobrescrevem canal/workspace.
  // null = herda do canal/workspace.
  distributionMode  String? // 'all' | 'fixed' | 'round_robin'
  defaultAssigneeId String? // FK lógica para User (não criamos FK física pra evitar cascata)
  roundRobinUserIds Json? // string[]
  rrCursor          Int? // estado interno do round-robin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id])
  contacts      Contact[] // DEPRECATED — relação N:1 antiga (ver Contact.companyId)
  contactLinks  ContactCompany[] // N:N (RF04)
  conversations Conversation[]
  cards         Card[]           @relation("CardCompany")

  @@index([workspaceId])
}

// ─── Conversations ───────────────────────────────────────────────────────────
model Conversation {
  id                  String             @id @default(cuid())
  workspaceId         String
  channelId           String
  contactId           String?
  companyId           String? // vínculo direto com empresa — útil para grupos (DMs herdam via contact.companyId)
  assigneeId          String? // usuário responsável (Fase 1: regras de canal)
  // Time atualmente dono da conversa. null = legado/sem time (fila pública geral).
  // Quando preenchido + assigneeId=null → conv está na "fila do time".
  teamId              String?
  externalId          String // chatId WA / threadId Gmail
  folder              String? // pasta IMAP de origem (só pra emails)
  subject             String?
  isGroup             Boolean            @default(false)
  favorite            Boolean            @default(false)
  archived            Boolean            @default(false)
  status              ConversationStatus @default(OPEN)
  source              ConvSource         @default(LIVE) // LIVE = real-time, IMPORTED = veio do sync histórico
  importedAt          DateTime? // marca quando foi importada via sync histórico
  claimedAt           DateTime? // quando alguém assumiu a conversa (Fase B)
  lastQueuedAt        DateTime? // última vez que entrou em fila (para métricas time-in-queue)
  eligibleAssigneeIds Json? // string[] | null. null = fila pública; preenchido = só esses users veem
  // Tags livres por conversa (string[]). Usadas por RoutingRules/Flows.
  tags                Json?
  metadata            Json? // Usado para armazenar avatarUrl de grupos, etc.
  releasedFrom        Json? // [{ userId, at, reason }] — DEPRECATED: usar ConversationTransfer. Mantido pra compat.
  lastMessageAt       DateTime?
  firstResponseAt     DateTime? // quando demos a primeira resposta
  resolvedAt          DateTime? // quando foi finalizada
  reopenCount         Int                @default(0) // vezes que reabriu
  triageCount         Int                @default(0) // vezes que foi triada
  unreadCount         Int                @default(0)
  // Chat interno: discrimina tipo da conversa. EXTERNAL = canais legados (WA/Email).
  type                ConversationType   @default(EXTERNAL)
  // Nome do grupo (somente quando type=GROUP). DIRECT/EXTERNAL ficam null.
  name                String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace      Workspace                 @relation(fields: [workspaceId], references: [id])
  channel        Channel                   @relation(fields: [channelId], references: [id])
  contact        Contact?                  @relation(fields: [contactId], references: [id])
  company        Company?                  @relation(fields: [companyId], references: [id])
  assignee       User?                     @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  team           Team?                     @relation(fields: [teamId], references: [id])
  messages       Message[]
  participants   ConversationParticipant[]
  reads          ConversationRead[]
  cards          Card[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  transfers      ConversationTransfer[]
  flowExecutions FlowExecution[]

  // Sem unique — múltiplos tickets por contato são permitidos (modelo ticket)
  @@index([channelId, externalId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, teamId, status])
  @@index([channelId, folder])
  @@index([workspaceId, source])
  @@index([workspaceId, companyId])
}

// ─── Messages ────────────────────────────────────────────────────────────────
model Message {
  id               String           @id @default(cuid())
  workspaceId      String
  conversationId   String
  direction        MessageDirection
  externalId       String?
  fromContactId    String?
  fromUserId       String?
  body             String           @db.MediumText
  bodyHtml         String?          @db.LongText
  attachments      Json?
  sentAt           DateTime
  receivedAt       DateTime         @default(now())
  aiClassification Json?
  taskId           String?
  deliveryStatus   String? // PENDING | SENT | DELIVERED | READ | PLAYED (outbound WA)
  metadata         Json? // dados específicos do canal (ex: imapUid, imapFolder p/ email)
  quotedMsgId      String? // externalId da mensagem citada
  quotedBody       String?          @db.Text
  quotedSender     String?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  conversation Conversation  @relation(fields: [conversationId], references: [id])
  fromContact  Contact?      @relation("MessageSender", fields: [fromContactId], references: [id])
  fromUser     User?         @relation("MessageUserSender", fields: [fromUserId], references: [id])
  reads        MessageRead[]

  @@unique([conversationId, externalId])
  @@index([workspaceId, conversationId, sentAt])
  @@index([fromUserId])
}

// ─── Chat Interno ────────────────────────────────────────────────────────────
// Participantes de conversas internas (DIRECT/GROUP). Não preenchido para EXTERNAL.
model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           ChatRole  @default(MEMBER)
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  mutedUntil     DateTime?
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
}

// Read-receipts granulares por participante (1 linha por (msg, user)).
model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([messageId, userId])
  @@index([userId, readAt])
}

// Leitura de conversa por usuário (inbox externo). Permite que "ler" limpe a
// notificação só de quem leu — conversas da fila continuam não-lidas pros outros.
// Uma mensagem nova apaga os registros da conversa (volta a ser não-lida pra todos).
model ConversationRead {
  conversationId String
  userId         String
  readAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
}

// ─── Kanban ──────────────────────────────────────────────────────────────────
// Visibilidade de board (RBAC fino, mesmo padrão de StorageFolder):
//   PRIVATE = só o ownerId vê
//   SHARED  = ownerId + users em BoardShare
//   PUBLIC  = todos do workspace
enum BoardVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

model Board {
  id          String          @id @default(cuid())
  workspaceId String
  ownerId     String? // null = legado (board global criado antes do enum)
  visibility  BoardVisibility @default(PRIVATE)
  name        String
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id])
  columns    Column[]
  shares     BoardShare[]
  teamShares BoardTeamShare[]
  tags       BoardTag[]

  @@index([workspaceId])
  @@index([workspaceId, ownerId])
}

model BoardShare {
  id        String   @id @default(cuid())
  boardId   String
  userId    String // usuário com acesso (além do dono)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

// Compartilhamento de board com um setor inteiro. Membros do setor ganham
// acesso de uso (ver/criar/mover cards); LEADERS do setor podem gerenciar
// (criar colunas, deletar, mudar visibilidade) — checado no endpoint.
model BoardTeamShare {
  id        String   @id @default(cuid())
  boardId   String
  teamId    String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([boardId, teamId])
  @@index([teamId])
}

// M2M Card ↔ Contact. O contactId legado no Card é mantido como
// "contato principal" para compat (busca/filtros antigos).
model CardContact {
  cardId    String
  contactId String
  createdAt DateTime @default(now())

  card    Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([cardId, contactId])
  @@index([contactId])
}

// M2M Card ↔ User (responsáveis). O assigneeId legado no Card é mantido
// como o "responsável principal" para compat; aqui adicionamos os demais.
model CardAssignee {
  cardId    String
  userId    String
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([cardId, userId])
  @@index([userId])
}

// Tag/etiqueta gerenciável por board (nome + cor), reutilizável entre cards.
model BoardTag {
  id          String   @id @default(cuid())
  workspaceId String
  boardId     String
  name        String
  color       String // hex, ex "#ef4444"
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  board Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardTag[]

  @@index([boardId])
}

// Junção N:N entre Card e BoardTag.
model CardTag {
  cardId    String
  tagId     String
  createdAt DateTime @default(now())

  card Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  BoardTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@index([tagId])
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  position  Int
  // Coluna de conclusão: cards aqui são "encerrados" e não contam como demanda
  // aberta nos KPIs. Dinâmico — qualquer coluna pode ser marcada como concluída.
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
}

model Card {
  id              String    @id @default(cuid())
  workspaceId     String
  columnId        String
  title           String
  description     String?   @db.Text
  priority        Priority  @default(MEDIUM)
  dueDate         DateTime?
  contactId       String?
  companyId       String?
  conversationId  String?
  createdBy       CreatedBy @default(USER)
  createdByUserId String? // quem clicou em "criar card" (null se foi criado pela IA/sistema)
  assigneeId      String?
  position        Int
  labels          Json?
  checklist       Json?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id])
  column       Column         @relation(fields: [columnId], references: [id])
  contact      Contact?       @relation(fields: [contactId], references: [id])
  company      Company?       @relation("CardCompany", fields: [companyId], references: [id])
  conversation Conversation?  @relation(fields: [conversationId], references: [id])
  creator      User?          @relation("CardCreator", fields: [createdByUserId], references: [id])
  contacts     CardContact[]
  assignees    CardAssignee[]
  history      CardHistory[]
  comments     CardComment[]
  attachments  Attachment[]
  tasks        Task[]
  cardTags     CardTag[]

  @@index([workspaceId, columnId, position])
  @@index([workspaceId, companyId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, createdByUserId])
}

model CardComment {
  id        String   @id @default(cuid())
  cardId    String
  userId    String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model CardHistory {
  id        String   @id @default(cuid())
  cardId    String
  userId    String?
  action    String
  payload   Json
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// ─── Tasks ───────────────────────────────────────────────────────────────────
model Task {
  id             String    @id @default(cuid())
  workspaceId    String
  cardId         String?
  contactId      String?
  conversationId String?
  messageId      String?
  assigneeId     String? // quem deve cumprir (User)
  title          String
  description    String?   @db.Text
  done           Boolean   @default(false)
  remindAt       DateTime?
  recurrence     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  card         Card?         @relation(fields: [cardId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([workspaceId, done])
  @@index([workspaceId, assigneeId, done])
  @@index([contactId])
  @@index([conversationId])
}

// ─── AI ──────────────────────────────────────────────────────────────────────
model Agent {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  systemPrompt String   @db.Text
  model        String
  provider     String
  temperature  Float    @default(0.4)
  tools        Json? // legacy / livre — não usado pelo runtime v2
  trigger      Json? // { type, filters, schedule? } — vê apps/api/src/modules/ai/triggers.ts
  enabledTools Json? // string[] dos tools habilitados (ver tools/registry.ts)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  logs      AIExecutionLog[]

  @@index([workspaceId, isActive])
}

model Prompt {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String   @db.Text
  version     Int      @default(1)
  tags        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model AIExecutionLog {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  provider    String
  model       String
  input       Json
  output      Json?
  tokensIn    Int?
  tokensOut   Int?
  costUsd     Decimal? @db.Decimal(10, 6)
  latencyMs   Int?
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  agent     Agent?    @relation(fields: [agentId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([agentId])
}

model MemoryChunk {
  id          String   @id @default(cuid())
  workspaceId String
  sourceType  String // conversation | card | document
  sourceId    String
  content     String   @db.Text
  embedding   Bytes?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, sourceType, sourceId])
}

// ─── Calendar ────────────────────────────────────────────────────────────────
model CalendarAccount {
