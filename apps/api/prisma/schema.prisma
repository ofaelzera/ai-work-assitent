// ─── Storage ─────────────────────────────────────────────────────────────────
enum StorageVisibility {
  PRIVATE // só o dono vê
  SHARED // dono + usuários listados em StorageFolderShare
  PUBLIC // todos do workspace veem
}

model StorageFolder {
  id          String            @id @default(cuid())
  workspaceId String
  ownerId     String // criador da pasta
  name        String
  visibility  StorageVisibility @default(PRIVATE)
  parentId    String? // null = raiz
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  parent    StorageFolder?       @relation("FolderTree", fields: [parentId], references: [id])
  children  StorageFolder[]      @relation("FolderTree")
  files     Attachment[]
  shares    StorageFolderShare[]

  @@index([workspaceId, parentId])
  @@index([workspaceId, ownerId])
}

model StorageFolderShare {
  id        String   @id @default(cuid())
  folderId  String
  userId    String // usuário com acesso (além do dono)
  createdAt DateTime @default(now())

  folder StorageFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@index([userId])
}

model Attachment {
  id          String            @id @default(cuid())
  workspaceId String
  uploadedBy  String
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String // path relativo em /storage/
  cardId      String?
  vaultItemId String?
  folderId    String? // pasta da biblioteca de arquivos (null = "Meus arquivos" raiz)
  visibility  StorageVisibility @default(PRIVATE)
  createdAt   DateTime          @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id])
  card      Card?             @relation(fields: [cardId], references: [id])
  folder    StorageFolder?    @relation(fields: [folderId], references: [id])
  shares    AttachmentShare[]

  @@index([workspaceId, cardId])
  @@index([workspaceId, folderId])
  @@index([workspaceId, uploadedBy])
}

model AttachmentShare {
  id           String   @id @default(cuid())
  attachmentId String
  userId       String
  createdAt    DateTime @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, userId])
  @@index([userId])
}

// ─── Events ──────────────────────────────────────────────────────────────────
model EventLog {
  id          String   @id @default(cuid())
  workspaceId String
  type        String // message.received, card.created, ai.executed, ...
  actorUserId String? // user que executou (null = sistema/worker)
