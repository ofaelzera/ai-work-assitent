// Horário de funcionamento da empresa (global por workspace).
model CompanyHours {
  id          String   @id @default(cuid())
  workspaceId String
  weekday     Int
  startMin    Int
  endMin      Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

