generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Workspace ────────────────────────────────────────────────────────────────
model Workspace {
  id        String   @id @default(cuid())
  name      String
  settings  Json?    // { distributionMode, defaultAssigneeId, roundRobinUserIds, claimTimeoutMinutes }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  channels        Channel[]
  contacts        Contact[]
  conversations   Conversation[]
  messages        Message[]
  boards          Board[]
  cards           Card[]
  tasks           Task[]
  agents          Agent[]
  prompts         Prompt[]
  aiLogs          AIExecutionLog[]
  memoryChunks    MemoryChunk[]
  calendarAccounts CalendarAccount[]
  calendarEvents  CalendarEvent[]
  vaultItems      VaultItem[]
  vaultFolders    VaultFolder[]
  attachments     Attachment[]
  storageFolders  StorageFolder[]
  eventLogs       EventLog[]
  companies       Company[]
  customRoles     CustomRole[]
}

// ─── Users ────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  workspaceId  String
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  customRoleId String?
  twoFactor    Boolean  @default(false)
  settings     Json?    // { welcomeMessage?, closingMessage?, signature?, ... }
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  refreshTokens RefreshToken[]
  vaultItems   VaultItem[]
  vaultFolders VaultFolder[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  assignedTasks         Task[]         @relation("TaskAssignee")
  events                EventLog[]     @relation("EventActor")
  sentMessages          Message[]      @relation("MessageUserSender")

  @@index([workspaceId])
  @@index([customRoleId])
}

// Roles customizáveis por workspace (RBAC).
// `permissions` é um array de strings (ex: ["conversations.viewAll", "cards.delete"]).
// `isSystem=true` = role criado no seed; não pode ser deletado pela UI.
model CustomRole {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  permissions Json     // string[] de permissions concedidas
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  users     User[]

  @@unique([workspaceId, name])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Channels ────────────────────────────────────────────────────────────────
model Channel {
  id          String        @id @default(cuid())
  workspaceId String
  type        ChannelType
  label       String
  status      ChannelStatus @default(DISCONNECTED)
  config      Json          // segredos cifrados em repouso (AES-256-GCM)
  signature   String?       @db.Text  // assinatura de email (HTML ou texto)
  settings    Json?         // não-criptografado: { ignoreGroups, defaultAssigneeId, autoResolveOnRead, distributionMode, imapFolders, lastAssignedUserId }
  lastSyncedAt DateTime?    // última sincronização bem-sucedida (usado pra delta sync)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  conversations Conversation[]

  @@index([workspaceId, type])
}

// ─── Contacts ────────────────────────────────────────────────────────────────
model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  name              String?
  phone             String?    // PN (Phone Number) — telefone real, ex: 5511999999999
  phoneType         PhoneType  @default(PN)  // PN = telefone real | LID = ID opaco WhatsApp
  lid               String?    // Linked ID opaco do WhatsApp (quando phoneType=LID)
  email             String?
  metadata          Json?
  companyId         String?
  mergedIntoId      String?   // aponta para o contato primário ao mesclar
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace        Workspace      @relation(fields: [workspaceId], references: [id])
  company          Company?       @relation(fields: [companyId], references: [id])
  conversations    Conversation[]
  cards            Card[]
  sentMessages     Message[]      @relation("MessageSender")
  tasks            Task[]
  calendarEvents   CalendarEvent[]

  @@index([workspaceId, phone])
  @@index([workspaceId, lid])
  @@index([workspaceId, email])
  @@index([workspaceId, companyId])
}

// ─── Companies ───────────────────────────────────────────────────────────────
model Company {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  color       String    @default("#6366f1")
  domain      String?   // ex: empresa.com.br
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  contacts  Contact[]

  @@index([workspaceId])
}

// ─── Conversations ───────────────────────────────────────────────────────────
model Conversation {
  id               String             @id @default(cuid())
  workspaceId      String
  channelId        String
  contactId        String?
  assigneeId       String?            // usuário responsável (Fase 1: regras de canal)
  externalId       String             // chatId WA / threadId Gmail
  folder           String?            // pasta IMAP de origem (só pra emails)
  subject          String?
  isGroup          Boolean            @default(false)
  favorite         Boolean            @default(false)
  archived         Boolean            @default(false)
  status           ConversationStatus @default(OPEN)
  source           ConvSource         @default(LIVE)  // LIVE = real-time, IMPORTED = veio do sync histórico
  importedAt       DateTime?          // marca quando foi importada via sync histórico
  claimedAt        DateTime?          // quando alguém assumiu a conversa (Fase B)
  releasedFrom     Json?              // [{ userId, at, reason }] — audit de devoluções (Fase B)
  lastMessageAt    DateTime?
  firstResponseAt  DateTime?          // quando demos a primeira resposta
  resolvedAt       DateTime?          // quando foi finalizada
  reopenCount      Int                @default(0) // vezes que reabriu
  triageCount      Int                @default(0) // vezes que foi triada
  unreadCount      Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  channel   Channel   @relation(fields: [channelId], references: [id])
  contact   Contact?  @relation(fields: [contactId], references: [id])
  assignee  User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  messages  Message[]
  cards     Card[]
  tasks     Task[]
  calendarEvents CalendarEvent[]

  // Sem unique — múltiplos tickets por contato são permitidos (modelo ticket)
  @@index([channelId, externalId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, assigneeId])
  @@index([channelId, folder])
  @@index([workspaceId, source])
}

// ─── Messages ────────────────────────────────────────────────────────────────
model Message {
  id               String           @id @default(cuid())
  workspaceId      String
  conversationId   String
  direction        MessageDirection
  externalId       String?
  fromContactId    String?
  fromUserId       String?
  body             String           @db.MediumText
  bodyHtml         String?          @db.LongText
  attachments      Json?
  sentAt           DateTime
  receivedAt       DateTime         @default(now())
  aiClassification Json?
  taskId           String?
  deliveryStatus   String?          // PENDING | SENT | DELIVERED | READ | PLAYED (outbound WA)
  metadata         Json?            // dados específicos do canal (ex: imapUid, imapFolder p/ email)
  quotedMsgId      String?          // externalId da mensagem citada
  quotedBody       String?          @db.Text
  quotedSender     String?

  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  fromContact  Contact?     @relation("MessageSender", fields: [fromContactId], references: [id])
  fromUser     User?        @relation("MessageUserSender", fields: [fromUserId], references: [id])

  @@unique([conversationId, externalId])
  @@index([workspaceId, conversationId, sentAt])
  @@index([fromUserId])
}

// ─── Kanban ──────────────────────────────────────────────────────────────────
// Visibilidade de board (RBAC fino, mesmo padrão de StorageFolder):
//   PRIVATE = só o ownerId vê
//   SHARED  = ownerId + users em BoardShare
//   PUBLIC  = todos do workspace
enum BoardVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

model Board {
  id          String           @id @default(cuid())
  workspaceId String
  ownerId     String?          // null = legado (board global criado antes do enum)
  visibility  BoardVisibility  @default(PRIVATE)
  name        String
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  columns   Column[]
  shares    BoardShare[]

  @@index([workspaceId])
  @@index([workspaceId, ownerId])
}

model BoardShare {
  id        String   @id @default(cuid())
  boardId   String
  userId    String   // usuário com acesso (além do dono)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
}

model Card {
  id             String    @id @default(cuid())
  workspaceId    String
  columnId       String
  title          String
  description    String?   @db.Text
  priority       Priority  @default(MEDIUM)
  dueDate        DateTime?
  contactId      String?
  conversationId String?
  createdBy      CreatedBy @default(USER)
  assigneeId     String?
  position       Int
  labels         Json?
  checklist      Json?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  column       Column        @relation(fields: [columnId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  history      CardHistory[]
  comments     CardComment[]
  attachments  Attachment[]
  tasks        Task[]

  @@index([workspaceId, columnId, position])
}

model CardComment {
  id        String   @id @default(cuid())
  cardId    String
  userId    String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model CardHistory {
  id        String   @id @default(cuid())
  cardId    String
  userId    String?
  action    String
  payload   Json
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// ─── Tasks ───────────────────────────────────────────────────────────────────
model Task {
  id             String    @id @default(cuid())
  workspaceId    String
  cardId         String?
  contactId      String?
  conversationId String?
  messageId      String?
  assigneeId     String?   // quem deve cumprir (User)
  title          String
  description    String?   @db.Text
  done           Boolean   @default(false)
  remindAt       DateTime?
  recurrence     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  card         Card?         @relation(fields: [cardId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([workspaceId, done])
  @@index([workspaceId, assigneeId, done])
  @@index([contactId])
  @@index([conversationId])
}

// ─── AI ──────────────────────────────────────────────────────────────────────
model Agent {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  systemPrompt String   @db.Text
  model        String
  provider     String
  temperature  Float    @default(0.4)
  tools        Json?    // legacy / livre — não usado pelo runtime v2
  trigger      Json?    // { type, filters, schedule? } — vê apps/api/src/modules/ai/triggers.ts
  enabledTools Json?    // string[] dos tools habilitados (ver tools/registry.ts)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  logs      AIExecutionLog[]

  @@index([workspaceId, isActive])
}

model Prompt {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String   @db.Text
  version     Int      @default(1)
  tags        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model AIExecutionLog {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  provider    String
  model       String
  input       Json
  output      Json?
  tokensIn    Int?
  tokensOut   Int?
  costUsd     Decimal? @db.Decimal(10, 6)
  latencyMs   Int?
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  agent     Agent?    @relation(fields: [agentId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([agentId])
}

model MemoryChunk {
  id          String   @id @default(cuid())
  workspaceId String
  sourceType  String   // conversation | card | document
  sourceId    String
  content     String   @db.Text
  embedding   Bytes?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, sourceType, sourceId])
}

// ─── Calendar ────────────────────────────────────────────────────────────────
model CalendarAccount {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  provider    String   @default("google")
  tokens      Json     // cifrado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  events    CalendarEvent[]

  @@unique([workspaceId, userId, provider])
}

model CalendarEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  ownerId         String   // user dono do evento (sempre obrigatório; eventos são por usuário)
  calendarAccountId String? // nullable: evento local (sem Google sync). Quando preenchido, está sincronizado.
  externalId      String?  // nullable: ID no Google Calendar quando sincronizado
  title           String
  description     String?  @db.Text
  startAt         DateTime
  endAt           DateTime
  cardId          String?
  contactId       String?
  conversationId  String?
  messageId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  calendarAccount CalendarAccount? @relation(fields: [calendarAccountId], references: [id])
  contact         Contact?         @relation(fields: [contactId], references: [id])
  conversation    Conversation?    @relation(fields: [conversationId], references: [id])

  @@unique([calendarAccountId, externalId])
  @@index([workspaceId, ownerId, startAt])
  @@index([contactId])
  @@index([conversationId])
}

// ─── Vault ───────────────────────────────────────────────────────────────────
model VaultItem {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String
  type        String   // password | ssh | ftp | db | api | note | file
  title       String
  folderId    String?
  tags        Json?
  favorite    Boolean  @default(false)
  ciphertext  Bytes
  iv          Bytes
  authTag     Bytes
  metadata    Json?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  owner     User         @relation(fields: [ownerId], references: [id])
  folder    VaultFolder? @relation(fields: [folderId], references: [id])

  @@index([workspaceId, ownerId])
}

model VaultFolder {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String
  name        String
  parentId    String?
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  owner     User        @relation(fields: [ownerId], references: [id])
  items     VaultItem[]

  @@index([workspaceId, ownerId])
}

// ─── Storage ─────────────────────────────────────────────────────────────────
enum StorageVisibility {
  PRIVATE  // só o dono vê
  SHARED   // dono + usuários listados em StorageFolderShare
  PUBLIC   // todos do workspace veem
}

model StorageFolder {
  id          String            @id @default(cuid())
  workspaceId String
  ownerId     String            // criador da pasta
  name        String
  visibility  StorageVisibility @default(PRIVATE)
  parentId    String?           // null = raiz
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  parent    StorageFolder? @relation("FolderTree", fields: [parentId], references: [id])
  children  StorageFolder[] @relation("FolderTree")
  files     Attachment[]
  shares    StorageFolderShare[]

  @@index([workspaceId, parentId])
  @@index([workspaceId, ownerId])
}

model StorageFolderShare {
  id        String   @id @default(cuid())
  folderId  String
  userId    String   // usuário com acesso (além do dono)
  createdAt DateTime @default(now())

  folder StorageFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@index([userId])
}

model Attachment {
  id          String   @id @default(cuid())
  workspaceId String
  uploadedBy  String
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String   // path relativo em /storage/
  cardId      String?
  vaultItemId String?
  folderId    String?  // pasta da biblioteca de arquivos (null = "Meus arquivos" raiz)
  visibility  StorageVisibility @default(PRIVATE)
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  card      Card?          @relation(fields: [cardId], references: [id])
  folder    StorageFolder? @relation(fields: [folderId], references: [id])
  shares    AttachmentShare[]

  @@index([workspaceId, cardId])
  @@index([workspaceId, folderId])
  @@index([workspaceId, uploadedBy])
}

model AttachmentShare {
  id           String   @id @default(cuid())
  attachmentId String
  userId       String
  createdAt    DateTime @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, userId])
  @@index([userId])
}

// ─── Events ──────────────────────────────────────────────────────────────────
model EventLog {
  id           String   @id @default(cuid())
  workspaceId  String
  type         String   // message.received, card.created, ai.executed, ...
  actorUserId  String?  // user que executou (null = sistema/worker)
  targetType   String?  // 'conversation', 'card', 'user', 'channel', ...
  targetId     String?  // id do alvo (pra filtrar timeline)
  payload      Json
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User?     @relation("EventActor", fields: [actorUserId], references: [id])

  @@index([workspaceId, type, createdAt])
  @@index([workspaceId, actorUserId, createdAt])
  @@index([workspaceId, targetType, targetId, createdAt])
}

// ─── Enums ───────────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  MEMBER
}

enum PhoneType {
  PN       // Phone Number — telefone real, contactável
  LID      // Linked ID — identificador opaco do WhatsApp (privacidade)
  UNKNOWN  // ainda não classificado
}

enum ChannelType {
  WHATSAPP
  GMAIL
  IMAP_SMTP
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CreatedBy {
  USER
  AI
}

enum ConversationStatus {
  OPEN      // em atendimento
  WAITING   // aguardando resposta do cliente
  RESOLVED  // finalizada
}

enum ConvSource {
  LIVE      // criada por mensagem real-time (Evolution socket)
  IMPORTED  // veio do sync de histórico — nasce RESOLVED
}
