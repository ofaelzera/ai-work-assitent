# ══════════════════════════════════════════════════════════════════════════════
# OBRIGATÓRIO — sem essas vars a API não sobe
# ══════════════════════════════════════════════════════════════════════════════

# Banco MySQL (recomenda-se MySQL 8+)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# Redis (usado pra rate-limit, filas BullMQ, presença e cache)
REDIS_URL="redis://127.0.0.1:6379"

# JWT — gere com: openssl rand -hex 32
JWT_ACCESS_SECRET="troque-isso-com-openssl-rand-hex-32"
JWT_REFRESH_SECRET="troque-isso-com-openssl-rand-hex-32"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Vault — chave AES-256, exatamente 64 chars hex. Gere com: openssl rand -hex 32
VAULT_MASTER_KEY="troque-isso-64-chars-hex"

# ══════════════════════════════════════════════════════════════════════════════
# Runtime da aplicação
# ══════════════════════════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3333
HOST=0.0.0.0
STORAGE_PATH=./storage

# ══════════════════════════════════════════════════════════════════════════════
# URLs públicas (essencial atrás de reverse proxy)
# ══════════════════════════════════════════════════════════════════════════════

# URL pública da API. O frontend injeta isso no <script> no <head> em runtime.
# Pra trocar: edite e rode `pm2 restart aiwa-web` (não precisa rebuild).
PUBLIC_API_URL="https://api.seudominio.com"

# URL pública do frontend. Usada pelo CORS da API e pelos redirects de OAuth.
WEB_URL="https://app.seudominio.com"

# Origens extras pra liberar no CORS, separadas por vírgula (opcional)
# CORS_ALLOWED_ORIGINS="https://admin.seudominio.com,https://staging.seudominio.com"

# ══════════════════════════════════════════════════════════════════════════════
# Opcional — WhatsApp via Evolution API
# ══════════════════════════════════════════════════════════════════════════════
# EVOLUTION_SERVER_URL="https://evolution.seudominio.com"
# EVOLUTION_API_KEY=""
# EVOLUTION_WEBHOOK_URL="https://api.seudominio.com/webhooks/whatsapp"
# EVOLUTION_WEBHOOK_SECRET=""

# ══════════════════════════════════════════════════════════════════════════════
# Opcional — WhatsApp via Meta Cloud API
# ══════════════════════════════════════════════════════════════════════════════
# META_WEBHOOK_VERIFY_TOKEN=""

# ══════════════════════════════════════════════════════════════════════════════
# Opcional — Provedores de IA
# ══════════════════════════════════════════════════════════════════════════════
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# OPENROUTER_API_KEY=""
# OPENROUTER_SITE_URL="https://app.seudominio.com"

# ══════════════════════════════════════════════════════════════════════════════
# Opcional — Google OAuth (Login Google + Gmail + Calendar)
# Crie em console.cloud.google.com → APIs → Credenciais → OAuth 2.0
# Adicione AMBOS os URIs em "URIs de redirecionamento autorizados"
# ══════════════════════════════════════════════════════════════════════════════
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_AUTH_REDIRECT_URI="https://api.seudominio.com/auth/google/callback"
# GOOGLE_REDIRECT_URI="https://api.seudominio.com/calendar/callback"

# ══════════════════════════════════════════════════════════════════════════════
# Apenas pra docker-compose.yml (ignorados pela API e pelo Web)
# Descomente se for usar o MySQL/Redis do docker-compose.yml
# ══════════════════════════════════════════════════════════════════════════════
# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_DATABASE=aiwa_assistant
# MYSQL_USER=aiwa
# MYSQL_PASSWORD=aiwapassword
