# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=aiwa
MYSQL_USER=aiwa
MYSQL_PASSWORD=aiwapassword

# ── API ──────────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://aiwa:aiwapassword@localhost:3306/aiwa"
REDIS_URL="redis://localhost:6379"
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# JWT — gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Vault — chave AES-256 (64 chars hex): openssl rand -hex 32
VAULT_MASTER_KEY=change_me_64hex_chars_aes256_key_here_000000000000000000000000

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=changeme_evolution_key
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3333/webhooks/whatsapp
EVOLUTION_WEBHOOK_SECRET=changeme_webhook_secret

# ── Google (Gmail + Calendar) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/channels/google/callback

# ── AI Providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3333
